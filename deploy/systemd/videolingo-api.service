[Unit]
Description=VideoLingo FastAPI
After=network.target redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/videolingo
ExecStart=/srv/videolingo/.venv/bin/uvicorn API.api:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
